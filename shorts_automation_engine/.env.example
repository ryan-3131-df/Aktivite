# ─────────────────────────────────────────────────────────────────────────────
# Shorts Automation Engine - copy this file to `.env` and fill in your keys.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED ────────────────────────────────────────────────────────────────────
# Script + metadata (Claude)   → https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key
# Voiceover                    → https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Stock footage                → https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key

# OPTIONAL ────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=                 # only for TIMESTAMP_BACKEND=openai (Whisper API)

# Script (Claude)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high              # low | medium | high | xhigh | max
# CLAUDE_FALLBACKS=true           # re-run a declined request on a fallback model
# LANGUAGE=en
# WORDS_PER_SECOND=2.9            # narration pace used to size the script

# Voice (ElevenLabs) - high-energy, fast-paced defaults
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# VOICE_STABILITY=0.32
# VOICE_SIMILARITY=0.80
# VOICE_STYLE=0.55
# VOICE_SPEED=1.10

# Word timestamps
# TIMESTAMP_BACKEND=auto          # auto | faster-whisper | openai | elevenlabs | estimate
# WHISPER_MODEL=base.en           # tiny.en | base.en | small.en | medium.en | large-v3
# WHISPER_DEVICE=auto             # auto | cpu | cuda

# Footage
# CLIPS_PER_RANK=2
# ALLOW_YTDLP=true
# YTDLP_CC_ONLY=true              # only Creative-Commons licensed YouTube results
# FIT_MODE=smart                  # smart | crop | blur
# BLUR_PAD_ZOOM=1.15
# HOOK_STYLE=montage              # montage | clip

# Audio
# VOICE_LUFS=-14
# MUSIC_LUFS=-22
# MUSIC_SIDECHAIN=false
# MUSIC_PATH=                     # force a specific background track
# USE_MUSIC=true

# Render
# VIDEO_FPS=60
# VIDEO_ENCODER=auto              # auto | libx264 | h264_nvenc | h264_videotoolbox | h264_qsv | h264_amf | h264_vaapi
# X264_PRESET=medium
# VIDEO_CRF=18
# KEN_BURNS_ZOOM=1.08
# CAPTION_FONT=                   # path to a .ttf to override assets/fonts/Montserrat-Black.ttf
# DISPLAY_FONT=                   # path to a .ttf to override assets/fonts/Anton-Regular.ttf
